{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traxpdf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "traxpdf.tracciondigital.com.mx",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51Ub7xLC4xcnK7usw4ayfhPPSay5EonfXWoAf0dSxiuOqpMbIQBHorn8Vr4E7rmj59HNso2SXcCCcRl4O73inG8tT00yb7KdXSM",
    "NEXT_PUBLIC_SITE_URL": "https://traxpdf.tracciondigital.com.mx"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "traxpdf"
    }
  ]
}
